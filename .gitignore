# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Variables de entorno y secretos (NO subir claves privadas)
.env
.env.*
!.env.example

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos de distribución y compilación
build/
dist/
*.egg-info/

# Archivos generados en tiempo de ejecución / persistencia local
app/requests_data.json
*.log

# Modelos locales y cachés de embeddings (FastEmbed / HuggingFace)
.cache/
hf_cache/

# Archivos temporales del sistema operativo o IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
